#!/usr/bin/env bash
#
# tests/harness/fake-claude — a stand-in for the real `claude` process.
#
# The daemon's engine adapter launches Claude Code and then watches it via the
# session PID + engine liveness (PLAN.md 4.1). Automated tests must never launch
# the real thing (PLAN.md section 10), so this script mimics Claude Code's
# *process shape* only: it writes a session.pid-compatible PID file and then
# behaves according to a mode. No Telegram, no network, no Anthropic.
#
# Modes (via env or flags — flags win):
#   normal              run forever until signalled (SIGTERM/SIGINT → clean exit 0)
#   not-logged-in       print an auth-style message to stderr, exit 1 quickly (<5s)
#   crash-after-<N>     run N seconds, then exit non-zero (simulated crash)
#
# Config:
#   --mode MODE / FAKE_CLAUDE_MODE            one of the above (default: normal)
#   --pid-file PATH / FAKE_CLAUDE_PID_FILE    where to write this process's PID
#   --crash-after N / FAKE_CLAUDE_CRASH_AFTER seconds for crash-after mode (default 3)
#   --auth-delay N / FAKE_CLAUDE_AUTH_DELAY   seconds before the not-logged-in exit
#                                             (default 0; must stay < 5 to match 1.6)
#
# Any other arguments (the claude-style argv the launcher passes) are ignored,
# so the engine can invoke this exactly where it would invoke the launcher.

set -u

mode="${FAKE_CLAUDE_MODE:-normal}"
pid_file="${FAKE_CLAUDE_PID_FILE:-}"
crash_after="${FAKE_CLAUDE_CRASH_AFTER:-3}"
auth_delay="${FAKE_CLAUDE_AUTH_DELAY:-0}"
sleep_pid=""

while [ $# -gt 0 ]; do
  case "$1" in
    --mode)        mode="${2:-}"; shift 2 ;;
    --pid-file)    pid_file="${2:-}"; shift 2 ;;
    --crash-after) crash_after="${2:-}"; shift 2 ;;
    --auth-delay)  auth_delay="${2:-}"; shift 2 ;;
    *)             shift ;;   # ignore claude-style args
  esac
done

# The plan spells the crash mode as a single token (crash-after-N); accept that
# form as well as `--mode crash-after --crash-after N`.
case "$mode" in
  crash-after-*) crash_after="${mode#crash-after-}"; mode="crash-after" ;;
esac

# Kill any backgrounded `sleep` child before exiting. Both long-lived modes run
# the sleep in the background so the TERM/INT trap can fire immediately (via an
# interrupted `wait`); without this the sleep is only signalled when it shares
# our process group. A parent-only SIGTERM (e.g. `subprocess.terminate()`, which
# does NOT signal the whole group) would otherwise orphan the sleep to init.
cleanup() {
  [ -n "${sleep_pid:-}" ] && kill "$sleep_pid" 2>/dev/null
  [ -n "$pid_file" ] && rm -f "$pid_file" 2>/dev/null
  return 0
}

# Record our own PID exactly as abs.sh records session.pid before exec'ing claude,
# so the daemon's liveness check has something to read. Written in every mode
# (a failed-login session still records a PID in real life).
if [ -n "$pid_file" ]; then
  mkdir -p "$(dirname "$pid_file")" 2>/dev/null
  printf '%s\n' "$$" > "$pid_file"
fi

case "$mode" in
  normal)
    trap 'cleanup; exit 0' TERM INT
    # Stay alive but interruptible: a backgrounded sleep + wait lets the trap
    # fire immediately on signal instead of after a full sleep interval. The
    # sleep PID is recorded so cleanup can kill it (no orphaned child).
    while :; do
      sleep 3600 &
      sleep_pid=$!
      wait "$sleep_pid"
    done
    ;;

  not-logged-in)
    [ "$auth_delay" != 0 ] && sleep "$auth_delay"
    # Auth-style stderr message. The daemon (PLAN.md 1.6) must NOT parse this as
    # its primary signal — the exit-code/timing is the signal — but a realistic
    # message lets the harness assert on it.
    printf '%s\n' "Invalid API key. Please run \`claude\` and complete login (not logged in)." >&2
    cleanup
    exit 1
    ;;

  crash-after)
    trap 'cleanup; exit 0' TERM INT
    # Backgrounded sleep + wait for the same reasons as normal mode: the trap
    # fires immediately on a parent-only SIGTERM/SIGINT and cleanup reaps the
    # sleep child instead of orphaning it.
    sleep "$crash_after" &
    sleep_pid=$!
    wait "$sleep_pid"
    printf '%s\n' "fake-claude: simulated crash after ${crash_after}s" >&2
    cleanup
    exit 42
    ;;

  *)
    printf '%s\n' "fake-claude: unknown mode: $mode" >&2
    cleanup
    exit 64
    ;;
esac
